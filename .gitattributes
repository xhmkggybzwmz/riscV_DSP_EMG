# Line-ending policy
#
# Scope is deliberately limited to file types and directories that do not
# exist yet (RTL, testbenches, scripts, RV32 software, new docs), so adding
# this file does not change how any currently tracked file is stored.
#
# Not covered on purpose (left to the existing core.autocrlf behaviour):
#   - firmware/stm32/**   (CubeMX project, stored with LF in the index)
#   - existing README.md / docs/*.md / host/**/*.py (some stored with CRLF)
# A repository-wide normalisation (`* text=auto`) would rewrite those files
# and should be a separate, explicitly approved commit.

# ---- HDL, constraints, Vivado scripts: always LF ----
*.v       text eol=lf
*.vh      text eol=lf
*.sv      text eol=lf
*.svh     text eol=lf
*.f       text eol=lf
*.tcl     text eol=lf
*.xdc     text eol=lf

# ---- Memory initialisation files: always LF ----
*.hex     text eol=lf
*.mem     text eol=lf
*.coe     text eol=lf

# ---- Shell scripts: LF; Windows scripts: CRLF ----
*.sh      text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# ---- New directories: everything text is LF ----
rtl/*/**          text=auto eol=lf
dv/*/**           text=auto eol=lf
tests/*/**        text=auto eol=lf
scripts/*/**      text=auto eol=lf
reference/*/**    text=auto eol=lf
fpga/*/**         text=auto eol=lf
firmware/rv32/**  text=auto eol=lf
docs/cpu/**       text=auto eol=lf
docs/soc/**       text=auto eol=lf
docs/dev/**       text=auto eol=lf

# ---- Vendored third-party files: stored and checked out byte for byte (SHA-256 in vendor/README.md) ----
visualization/web/vendor/** -text
# Board-tested build records (HWH / manifest): byte for byte, SHA-256 in fpga/kv260/release/SHA256SUMS
fpga/kv260/release/** -text
# Regenerated by scripts/sim/gen_e4c.py with LF: must not look modified after a CRLF checkout
host/gesture_server/tests/fixtures/*.json text eol=lf

# ---- Binary build products (never diffed or converted) ----
*.elf     binary
*.bin     binary
*.o       binary
*.obj     binary
*.a       binary
*.bit     binary
*.xsa     binary
*.dcp     binary
*.pdi     binary
*.wdb     binary
*.png     binary
*.jpg     binary
*.pdf     binary
